# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/feedbackos?schema=public"

# ─────────────────────────────────────────────
# REDIS (Upstash or local)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# GROQ
# ─────────────────────────────────────────────
GROQ_API_KEY="gsk_..."

# ─────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─────────────────────────────────────────────
# GOOGLE OAUTH
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# EMAIL (Resend for magic links + alerts)
# ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@feedbackos.app"

# ─────────────────────────────────────────────
# ZENDESK
# ─────────────────────────────────────────────
ZENDESK_SUBDOMAIN=""
ZENDESK_API_TOKEN=""
ZENDESK_EMAIL=""

# ─────────────────────────────────────────────
# INTERCOM
# ─────────────────────────────────────────────
INTERCOM_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# ENCRYPTION (AES-256) — generate: openssl rand -hex 32
# ─────────────────────────────────────────────
ENCRYPTION_KEY=""

# ─────────────────────────────────────────────
# WORKER
# ─────────────────────────────────────────────
WORKER_CONCURRENCY="5"

# Serverless classification recovery; configure separately per environment.
CRON_SECRET=""

# ─────────────────────────────────────────────
# PRIVATE CSV IMPORTS (Vercel Blob, private store; injected by Vercel when the store is connected)
# ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
# Optional: new feedback items (manual + CSV) each workspace may add per UTC day; all workspaces share one AI quota. Default 500.
WORKSPACE_DAILY_ITEM_LIMIT=
