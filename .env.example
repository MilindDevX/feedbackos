# FeedbackOS environment variables. Copy to .env for local work; set them in Vercel for deployments.
# Never commit real values. Generate secrets with: openssl rand -hex 32

# ── Core (required) ─────────────────────────────────────────────────────────────
# PostgreSQL. On Neon use the pooled URL here; production builds derive the direct URL for migrations.
DATABASE_URL=
# Redis for caching and rate limits (rediss:// in production, e.g. Upstash).
REDIS_URL=
# Groq API key for classification (OpenAI-compatible endpoint, model openai/gpt-oss-120b).
GROQ_API_KEY=
# 32-byte hex key that encrypts stored integration credentials.
ENCRYPTION_KEY=

# ── Authentication (required) ───────────────────────────────────────────────────
# Public URL of the app, e.g. https://feedbackos.vercel.app or http://localhost:3000
NEXTAUTH_URL=
NEXTAUTH_SECRET=
AUTH_SECRET=
# Google sign-in (Google Cloud → OAuth client, redirect URI <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Magic-link email (required for email sign-in) ──────────────────────────────
# Any SMTP server. Gmail: smtp.gmail.com, 465, the Gmail address, a Google App Password.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
# Optional display sender; on Gmail SMTP the app always sends as EMAIL_SERVER_USER.
EMAIL_FROM=

# ── Serverless jobs and storage (Vercel) ────────────────────────────────────────
# Protects the daily recovery cron (/api/cron/classification). Required in production.
CRON_SECRET=
# Private Blob store for CSV imports; injected by Vercel when the store is connected.
BLOB_READ_WRITE_TOKEN=

# ── Optional switches ──────────────────────────────────────────────────────────
# New feedback items (manual + CSV) each workspace may add per UTC day. Default 500.
WORKSPACE_DAILY_ITEM_LIMIT=
# Public read-only demo at /api/demo. On by default; set 0 to turn it off.
DEMO_ENABLED=
# Zendesk/Intercom need the BullMQ worker, which is not deployed. Leave unset ("coming soon") until it is.
INTEGRATIONS_ENABLED=
# Only used when INTEGRATIONS_ENABLED=1
INTERCOM_WEBHOOK_SECRET=
ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=
WORKER_CONCURRENCY=

# ── Local automated testing only ───────────────────────────────────────────────
# next dev on localhost: enables /api/test/login and an in-process classification queue. Never set on Vercel.
LOCAL_TEST_MODE=
